# IndiHunt Environment Variables Example
# Duplicate this file as .env and replace placeholder values with your credentials

# Dodo Payments
DODO_ENVIRONMENT=test_or_live
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key
DODO_PRODUCT_ID=your_dodo_product_id
DODO_WEBHOOK_ENDPOINT_ID=your_dodo_webhook_endpoint_id
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Upstash QStash
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Resend (Email Service)
RESEND_API_KEY=your_resend_api_key
